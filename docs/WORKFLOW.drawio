ếp vào chỗ trống" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#d79b00;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="kéo image" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#999999;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c15" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2. Luồng Score (cold start)" id="2._Luồng_Score_(cold_start)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Luồng bấm Score: từ giao diện đến lúc có điểm (API và worker đều đang ở 0 pod)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1400" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Người dùng / Frontend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="260" height="800" as="geometry"/></mxCell><mxCell id="c4" value="Interceptor KEDA + API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="50" width="260" height="800" as="geometry"/></mxCell><mxCell id="c5" value="Aurora và SQS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="620" y="50" width="260" height="800" as="geometry"/></mxCell><mxCell id="c6" value="KEDA + Worker (Job)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="900" y="50" width="260" height="800" as="geometry"/></mxCell><mxCell id="c7" value="1. Bấm Score&lt;br&gt;đồng hồ &quot;API&quot; và &quot;Worker&quot; bắt đầu chạy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="60" as="geometry"/></mxCell><mxCell id="c8" value="2. Interceptor thấy request, bật API từ 0 pod&lt;br&gt;(đo: pod được tạo sau 0,7 giây; request đầu 1,9 đến 3,3 giây)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="220" height="70" as="geometry"/></mxCell><mxCell id="c9" value="3. API đánh dấu hồ sơ &quot;queued&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="210" width="220" height="60" as="geometry"/></mxCell><mxCell id="c10" value="Aurora: screening_status = queued" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="210" width="220" height="50" as="geometry"/></mxCell><mxCell id="c11" value="4. API gửi message vào SQS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="310" width="220" height="60" as="geometry"/></mxCell><mxCell id="c12" value="SQS: message vào hàng đợi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="310" width="220" height="50" as="geometry"/></mxCell><mxCell id="c13" value="5. API trả 202 cho người dùng ngay&lt;br&gt;(khung &quot;API response time&quot; dừng)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="410" width="220" height="70" as="geometry"/></mxCell><mxCell id="c14" value="6. API tạo ngay 1 Job worker (chạy nền)&lt;br&gt;nếu chưa có 3 Job đang chạy;&lt;br&gt;Job mang nhãn của ScaledJob" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="520" width="220" height="80" as="geometry"/></mxCell><mxCell id="c15" value="KEDA (đường dự phòng): thấy hàng đợi có việc,&lt;br&gt;tạo Job; không tạo trùng nhờ nhãn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="920" y="310" width="220" height="70" as="geometry"/></mxCell><mxCell id="c16" value="7. Pod worker khởi động&lt;br&gt;xếp vào chỗ trống, image đã tải sẵn&lt;br&gt;(dưới 1 giây; nghẽn IP có thể thêm 10 đến 40 giây)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="520" width="220" height="70" as="geometry"/></mxCell><mxCell id="c17" value="8. Nhận tối đa 10 message,&lt;br&gt;chấm điểm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="630" width="220" height="60" as="geometry"/></mxCell><mxCell id="c18" value="9. Aurora: score, done; SQS: xoá message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="630" width="220" height="60" as="geometry"/></mxCell><mxCell id="c19" value="10. Job kết thúc, pod thoát" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a