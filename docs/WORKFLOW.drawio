<mxfile host="app.diagrams.net" version="24.0.0"><diagram name="1. Kiến trúc và luồng request" id="1._Kiến_trúc_và_luồng_request"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Hệ thống tuyển dụng trên EKS (toàn bộ node spot, amd64 + arm64): luồng request và ba tầng co giãn" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1400" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Người dùng" style="shape=umlActor;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="60" height="80" as="geometry"/></mxCell><mxCell id="c4" value="ALB&lt;br&gt;HTTP, chỉ cho phép IP đã khai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="335" width="120" height="70" as="geometry"/></mxCell><mxCell id="c5" value="Cụm EKS ap-southeast-1 (node spot do Karpenter quản lý)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#999999;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="300" y="50" width="850" height="790" as="geometry"/></mxCell><mxCell id="c6" value="Frontend (nginx + React)&lt;br&gt;HPA: CPU 50% so với mức xin&lt;br&gt;1 đến 2 pod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="220" height="90" as="geometry"/></mxCell><mxCell id="c7" value="Giám sát và log&lt;br&gt;Prometheus, Grafana&lt;br&gt;Loki + Alloy (mọi node)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="100" width="240" height="90" as="geometry"/></mxCell><mxCell id="c8" value="Interceptor KEDA HTTP (2 pod)&lt;br&gt;giữ request khi API đang 0 pod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="290" width="200" height="90" as="geometry"/></mxCell><mxCell id="c9" value="API Go (33 route)&lt;br&gt;KEDA HTTP: 100 request đồng thời mỗi pod + CPU 70%&lt;br&gt;0 đến 2 pod, về 0 sau 300 giây rảnh&lt;br&gt;250m CPU, 64 MiB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="270" width="240" height="130" as="geometry"/></mxCell><mxCell id="c10" value="KEDA ScaledJob (worker)&lt;br&gt;hỏi SQS mỗi 1 giây&lt;br&gt;mỗi Job lấy tối đa 10 message&lt;br&gt;tối đa 20 Job cùng lúc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="470" width="200" height="100" as="geometry"/></mxCell><mxCell id="c11" value="Worker Go (Kubernetes Job)&lt;br&gt;mỗi Job nhận tối đa 10 message rồi thoát&lt;br&gt;chấm điểm, ghi vào Aurora&lt;br&gt;0 đến 20 Job, 100m CPU, 64 MiB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="470" width="240" height="110" as="geometry"/></mxCell><mxCell id="c12" value="Tầng node: Karpenter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="620" width="790" height="200" as="geometry"/></mxCell><mxCell id="c13" value="Pool default: tối đa 16 vCPU&lt;br&gt;chạy API, frontend&lt;br&gt;gom node thừa sau 1 phút" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="660" width="230" height="90" as="geometry"/></mxCell><mxCell id="c14" value="Pod giữ chỗ (500m / 512 MiB)&lt;br&gt;giữ 2 node default luôn chạy&lt;br&gt;1 amd64 + 1 arm64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="660" width="230" height="90" as="geometry"/></mxCell><mxCell id="c15" value="image-prepuller&lt;br&gt;tải sẵn image api, worker, web&lt;br&gt;lên mọi node Karpenter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="660" width="250" height="90" as="geometry"/></mxCell><mxCell id="c16" value="2 node hệ thống cố định (Karpenter, KEDA, CoreDNS, Prometheus, Grafana, Loki). Pool &lt;b&gt;worker&lt;/b&gt; riêng (node 4 vCPU, tối đa 12 vCPU, taint) có pod giữ chỗ riêng, chạy các Job worker." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="760" width="750" height="50" as="geometry"/></mxCell><mxCell id="c17" value="Dịch vụ AWS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#999999;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1190" y="50" width="280" height="790" as="geometry"/></mxCell><mxCell id="c18" value="S3 demo-logs&lt;br&gt;lưu log, tự xoá sau 7 ngày" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1210" y="100" width="240" height="70" as="geometry"/></mxCell><mxCell id="c19" value="Aurora Serverless v2 (PostgreSQL)&lt;br&gt;0,5 đến 2 ACU, không tạm dừng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1210" y="290" width="240" height="100" as="geometry"/></mxCell><mxCell id="c20" value="SQS demo-jobs&lt;br&gt;thời gian ẩn 60 giây, tối đa 3 lần nhận&lt;br&gt;+ hàng đợi lỗi (DLQ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1210" y="450" width="240" height="90" as="geometry"/></mxCell><mxCell id="c21" value="ECR&lt;br&gt;image api, worker, web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1210" y="680" width="240" height="70" as="geometry"/></mxCell><mxCell id="c22" value="1" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="2. trang web" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="3. Host api.demo.local" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="4. bật API từ 0 pod" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="5. đọc/ghi dữ liệu" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="6. gửi message" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c20"><mxGeometry x="-0.5" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="7. đếm hàng đợi" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c10" target="c20"><mxGeometry x="-0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="440"/><mxPoint x="1170" y="440"/><mxPoint x="1170" y="495"/></Array></mxGeometry></mxCell><mxCell id="c29" value="8. tạo Job" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="9. nhận / xoá message" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c20"><mxGeometry x="-0.2" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="10. ghi điểm" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c19"><mxGeometry x="0.6" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="log → Loki → S3" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c7" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="kéo image" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c12" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="2. Luồng Score (cold start)" id="2._Luồng_Score_(cold_start)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Luồng bấm Score: từ giao diện đến lúc có điểm (API và worker đều có thể đang ở 0 pod)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1400" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Người dùng / Frontend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#bbbbbb;fontSize=13;verticalAlign=top;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="260" height="800" as="geometry"/></mxCell><mxCell id="c4" value="Interceptor KEDA + API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#bbbbbb;fontSize=13;verticalAlign=top;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="300" y="50" width="260" height="800" as="geometry"/></mxCell><mxCell id="c5" value="Aurora và SQS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#bbbbbb;fontSize=13;verticalAlign=top;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="620" y="50" width="260" height="800" as="geometry"/></mxCell><mxCell id="c6" value="KEDA + Worker (Job)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#bbbbbb;fontSize=13;verticalAlign=top;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="900" y="50" width="260" height="800" as="geometry"/></mxCell><mxCell id="c7" value='1. Bấm Score&lt;br&gt;đồng hồ "API" và "Worker" bắt đầu chạy' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="60" as="geometry"/></mxCell><mxCell id="c8" value="2. Interceptor chuyển request; nếu API đang 0 pod thì bật lên&lt;br&gt;(đo: cold start API 2,08 giây phía hệ thống)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="220" height="80" as="geometry"/></mxCell><mxCell id="c9" value='3. API đánh dấu hồ sơ "queued"' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="220" width="220" height="50" as="geometry"/></mxCell><mxCell id="c10" value="Aurora: screening_status = queued" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="220" width="220" height="50" as="geometry"/></mxCell><mxCell id="c11" value="4. API gửi message vào SQS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="310" width="220" height="50" as="geometry"/></mxCell><mxCell id="c12" value="SQS: message vào hàng đợi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="310" width="220" height="50" as="geometry"/></mxCell><mxCell id="c13" value='5. API trả 202 ngay&lt;br&gt;(khung "API response time" dừng)' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="400" width="220" height="60" as="geometry"/></mxCell><mxCell id="c14" value="6. KEDA hỏi số đếm hàng đợi mỗi 1 giây&lt;br&gt;số đếm SQS bị cũ vài giây nên phát hiện việc sau 6 đến 17 giây (đây là phần chậm nhất)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="300" width="220" height="100" as="geometry"/></mxCell><mxCell id="c15" value="7. KEDA tạo Job; pod worker khởi động&lt;br&gt;xếp vào chỗ trống, image đã tải sẵn (khoảng 0,4 giây; nghẽn IP có thể thêm 10 đến 40 giây khi dồn nhiều Job)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="440" width="220" height="100" as="geometry"/></mxCell><mxCell id="c16" value="8. Nhận tối đa 10 message, chấm điểm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="570" width="220" height="50" as="geometry"/></mxCell><mxCell id="c17" value="9. Aurora: score, done&lt;br&gt;SQS: xoá message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="570" width="220" height="60" as="geometry"/></mxCell><mxCell id="c18" value="10. Job kết thúc, pod thoát&lt;br&gt;(đôi khi có Job rỗng dư thoát ngay)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="670" width="220" height="60" as="geometry"/></mxCell><mxCell id="c19" value='11. Frontend hỏi lại mỗi 1 giây, thấy "done", hiện điểm&lt;br&gt;đồng hồ "Worker scoring time" dừng' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="220" height="80" as="geometry"/></mxCell><mxCell id="c20" value="POST /screen" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry x="-0.4" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="ghi" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="gửi" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="202" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c13" target="c7"><mxGeometry x="0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="430"/><mxPoint x="150" y="430"/></Array></mxGeometry></mxCell><mxCell id="c27" value="đếm" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="ghi + xoá" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="đọc kết quả" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="Số đo (20 lượt mỗi chu kỳ): điểm hiện sau trung vị 10,2 giây từ lúc có message (KEDA hỏi mỗi 1 giây); 17,4 / 12,2 giây ở chu kỳ 10 / 30 giây; không lượt nào dưới 3 giây. Mỗi Score tạo 1 đến 3 Job. Khi chạy riêng, pod worker chỉ mất khoảng 0,4 giây. Phương án đã thử, không chọn: giữ 1 worker nóng cho 0,39 giây." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="1200" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3. Các tầng scale" id="3._Các_tầng_scale"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Các tầng co giãn và cấu hình đang chạy" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1400" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Tầng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dddddd;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="140" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Công cụ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dddddd;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="170" y="60" width="200" height="40" as="geometry"/></mxCell><mxCell id="c5" value="Co giãn theo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dddddd;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="310" height="40" as="geometry"/></mxCell><mxCell id="c6" value="Phạm vi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dddddd;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="190" height="40" as="geometry"/></mxCell><mxCell id="c7" value="Ghi chú" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dddddd;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="60" width="520" height="40" as="geometry"/></mxCell><mxCell id="c8" value="Node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="140" height="90" as="geometry"/></mxCell><mxCell id="c9" value="Karpenter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="170" y="110" width="200" height="90" as="geometry"/></mxCell><mxCell id="c10" value="pod chưa xếp được vào node nào" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="110" width="310" height="90" as="geometry"/></mxCell><mxCell id="c11" value="pool default: tối đa 16 vCPU; pool worker: tối đa 12 vCPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="110" width="190" height="90" as="geometry"/></mxCell><mxCell id="c12" value="gom node thừa sau 1 phút; 2 node nền luôn chạy nhờ pod giữ chỗ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="110" width="520" height="90" as="geometry"/></mxCell><mxCell id="c13" value="API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="210" width="140" height="90" as="geometry"/></mxCell><mxCell id="c14" value="KEDA HTTP Add-on" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="170" y="210" width="200" height="90" as="geometry"/></mxCell><mxCell id="c15" value="số request đồng thời (mục tiêu 100 mỗi pod) và CPU 70%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="210" width="310" height="90" as="geometry"/></mxCell><mxCell id="c16" value="0 đến 2 pod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="210" width="190" height="90" as="geometry"/></mxCell><mxCell id="c17" value="về 0 sau 300 giây rảnh; interceptor giữ request khi API đang 0 pod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="210" width="520" height="90" as="geometry"/></mxCell><mxCell id="c18" value="Frontend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="310" width="140" height="90" as="geometry"/></mxCell><mxCell id="c19" value="HPA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="170" y="310" width="200" height="90" as="geometry"/></mxCell><mxCell id="c20" value="CPU, mục tiêu 50% mức xin (100m)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="310" width="310" height="90" as="geometry"/></mxCell><mxCell id="c21" value="1 đến 2 pod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="310" width="190" height="90" as="geometry"/></mxCell><mxCell id="c22" value="tăng 1 pod mỗi 15 giây; giảm sau 300 giây ổn định" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="310" width="520" height="90" as="geometry"/></mxCell><mxCell id="c23" value="Worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="410" width="140" height="90" as="geometry"/></mxCell><mxCell id="c24" value="KEDA ScaledJob (aws-sqs-queue)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="170" y="410" width="200" height="90" as="geometry"/></mxCell><mxCell id="c25" value="độ dài hàng đợi SQS; mỗi Job lấy tối đa 10 message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="410" width="310" height="90" as="geometry"/></mxCell><mxCell id="c26" value="0 đến 20 Job cùng lúc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="410" width="190" height="90" as="geometry"/></mxCell><mxCell id="c27" value="KEDA hỏi mỗi 1 giây; cold start trung vị 10,2 giây (đã đo); mỗi Score tạo 1 đến 3 Job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="410" width="520" height="90" as="geometry"/></mxCell><mxCell id="c28" value="Dữ liệu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="510" width="140" height="90" as="geometry"/></mxCell><mxCell id="c29" value="Aurora Serverless v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="170" y="510" width="200" height="90" as="geometry"/></mxCell><mxCell id="c30" value="tải của database" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="510" width="310" height="90" as="geometry"/></mxCell><mxCell id="c31" value="0,5 đến 2 ACU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="510" width="190" height="90" as="geometry"/></mxCell><mxCell id="c32" value="tăng giảm từng bước 0,5 ACU; không tạm dừng; chạm trần 2 ACU khi 200 user cùng lúc (không lỗi)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="510" width="520" height="90" as="geometry"/></mxCell><mxCell id="c33" value="Khác nhau giữa API và worker: API phục vụ người đang chờ nên dùng Deployment + KEDA HTTP (request đi qua interceptor, có thể về 0 pod). Worker xử lý việc nền theo lô nên dùng ScaledJob: mỗi lô một Job riêng, cô lập, nhưng phải chờ KEDA phát hiện việc." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="620" width="1400" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>