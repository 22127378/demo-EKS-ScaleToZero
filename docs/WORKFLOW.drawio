<mxfile host="app.diagrams.net" version="24.0.0"><diagram name="1. Kiến trúc và luồng request" id="1._Kiến_trúc_và_luồng_request"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Hệ thống tuyển dụng trên EKS (toàn bộ node spot, amd64 + arm64): luồng request và ba tầng co giãn" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=16;fontColor=#111111;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1400" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Người dùng" style="shape=umlActor;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="60" height="80" as="geometry"/></mxCell><mxCell id="c4" value="ALB&lt;br&gt;HTTP, chỉ cho phép IP đã khai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="335" width="120" height="70" as="geometry"/></mxCell><mxCell id="c5" value="Cụm EKS ap-southeast-1 (node spot do Karpenter quản lý)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="300" y="50" width="850" height="790" as="geometry"/></mxCell><mxCell id="c6" value="Frontend (nginx + React)&lt;br&gt;HPA: CPU 50% / pod xin 100m&lt;br&gt;1 đến 2 pod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="100" width="220" height="90" as="geometry"/></mxCell><mxCell id="c7" value="Interceptor KEDA HTTP (2 pod)&lt;br&gt;giữ request khi API đang 0 pod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="290" width="200" height="90" as="geometry"/></mxCell><mxCell id="c8" value="API Go (33 route)&lt;br&gt;KEDA HTTP: 100 request đồng thời / pod&lt;br&gt;0 đến 2 pod, về 0 sau 10 giây rảnh (demo)&lt;br&gt;250m CPU, 64 MiB mỗi pod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="270" width="240" height="130" as="geometry"/></mxCell><mxCell id="c9" value="Giám sát và log&lt;br&gt;Prometheus, Grafana&lt;br&gt;Loki + Alloy (mọi node)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="100" width="240" height="90" as="geometry"/></mxCell><mxCell id="c10" value="KEDA ScaledJob (worker)&lt;br&gt;hỏi SQS mỗi 1 giây&lt;br&gt;chiến lược default, tối đa 20 Job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="470" width="200" height="100" as="geometry"/></mxCell><mxCell id="c11" value="Worker (Kubernetes Job)&lt;br&gt;mỗi Job lấy tối đa 10 message rồi thoát&lt;br&gt;chấm điểm, ghi vào Aurora&lt;br&gt;100m CPU, 64 MiB; 0 đến 20 Job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="470" width="240" height="110" as="geometry"/></mxCell><mxCell id="c12" value="Tầng node: Karpenter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="330" y="620" width="790" height="200" as="geometry"/></mxCell><mxCell id="c13" value="Pool default: tối đa 16 vCPU&lt;br&gt;chạy API, frontend, worker&lt;br&gt;gom node thừa sau 1 phút" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="660" width="230" height="90" as="geometry"/></mxCell><mxCell id="c14" value="Pod giữ chỗ (500m / 512 MiB)&lt;br&gt;giữ 2 node default luôn chạy&lt;br&gt;1 amd64 + 1 arm64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="660" width="230" height="90" as="geometry"/></mxCell><mxCell id="c15" value="image-prepuller&lt;br&gt;tải sẵn image api, worker, web&lt;br&gt;lên mọi node Karpenter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="850" y="660" width="250" height="90" as="geometry"/></mxCell><mxCell id="c16" value="2 node hệ thống cố định (chạy Karpenter, KEDA, CoreDNS, Prometheus, Grafana, Loki). Pool worker (12 vCPU) tồn tại nhưng hiện không dùng." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="350" y="760" width="750" height="50" as="geometry"/></mxCell><mxCell id="c17" value="Dịch vụ AWS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="1190" y="50" width="280" height="790" as="geometry"/></mxCell><mxCell id="c18" value="S3 demo-logs&lt;br&gt;lưu log, tự xoá sau 7 ngày" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1210" y="100" width="240" height="70" as="geometry"/></mxCell><mxCell id="c19" value="Aurora Serverless v2 (PostgreSQL)&lt;br&gt;0,5 đến 2 ACU, không tạm dừng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1210" y="290" width="240" height="100" as="geometry"/></mxCell><mxCell id="c20" value="SQS demo-jobs&lt;br&gt;thời gian ẩn 60 giây, tối đa 3 lần nhận&lt;br&gt;+ hàng đợi lỗi (D